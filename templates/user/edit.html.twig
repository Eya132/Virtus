{% extends 'base.html.twig' %}

{% block title %}Modifier Utilisateur{% endblock %}

{% block current_page %}Utilisateurs > Modifier{% endblock %}
{% block page_title %}Modifier l'Utilisateur{% endblock %}

{% block main_content %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header pb-0">
                    <h6>Formulaire de modification</h6>
                </div>
                <div class="card-body px-4 pt-0 pb-2">
                    {{ form_start(form, {'attr': {
                        'class': 'row g-3',
                        'novalidate': 'novalidate',
                        'data-is-edit': 'true'
                    }}) }}
                    
                    {# Champ Email #}
                    <div class="col-md-6">
                        {{ form_label(form.email_user, 'Email', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.email_user, {'attr': {
                            'class': 'form-control',
                            'placeholder': 'exemple@domaine.com'
                        }}) }}
                        {{ form_errors(form.email_user) }}
                    </div>
                    
                    {# Champ Mot de passe #}
                    <div class="col-md-6">
                        {{ form_label(form.password_user, 'Nouveau mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.password_user, {'attr': {
                            'class': 'form-control',
                            'placeholder': 'Laisser vide pour ne pas changer'
                        }}) }}
                        <small class="form-text text-muted">6 caractères minimum dont un chiffre</small>
                        {{ form_errors(form.password_user) }}
                    </div>
                    
                    {# Champ Nom #}
                    <div class="col-md-6">
                        {{ form_label(form.nom_user, 'Nom', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.nom_user, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.nom_user) }}
                    </div>
                    
                    {# Champ Prénom #}
                    <div class="col-md-6">
                        {{ form_label(form.prenom_user, 'Prénom', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.prenom_user, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.prenom_user) }}
                    </div>
                    
                    {# Champ Sexe #}
                    <div class="col-md-6">
                        {{ form_label(form.sexe_user, 'Sexe', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.sexe_user, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.sexe_user) }}
                    </div>
                    
                    {# Champ Téléphone #}
                    <div class="col-md-6">
                        {{ form_label(form.telephone_user, 'Téléphone', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.telephone_user, {'attr': {
                            'class': 'form-control',
                            'placeholder': 'Commence par 2, 5 ou 9'
                        }}) }}
                        {{ form_errors(form.telephone_user) }}
                    </div>
                    
                    {# Champ Adresse #}
                    <div class="col-12">
                        {{ form_label(form.adresse_user, 'Adresse', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.adresse_user, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.adresse_user) }}
                    </div>
                    
                    {# Champ Rôle #}
                    <div class="col-md-6">
                        {{ form_label(form.role, 'Rôle', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.role, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.role) }}
                    </div>
                    
                    {# Champ Expérience #}
                    <div class="col-md-6">
                        {{ form_label(form.experience, 'Expérience', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.experience, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.experience) }}
                    </div>
                    
                    {# Champ Niveau Joueur #}
                    <div class="col-md-6">
                        {{ form_label(form.niveau_joueur, 'Niveau du joueur', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.niveau_joueur, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.niveau_joueur) }}
                    </div>
                    
                    {# Champ Premium #}
                    <div class="col-md-6">
                        {{ form_label(form.is_premium, 'Premium', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.is_premium, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.is_premium) }}
                    </div>
                    
                    {# Champ Date de Naissance #}
                    <div class="col-md-6">
                        {{ form_label(form.date_naissance_user, 'Date de naissance', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.date_naissance_user, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.date_naissance_user) }}
                    </div>
                    
                    {# Champ Salaire #}
                    <div class="col-md-6">
                        {{ form_label(form.salaire, 'Salaire', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.salaire, {'attr': {
                            'class': 'form-control',
                            'min': 0
                        }}) }}
                        {{ form_errors(form.salaire) }}
                    </div>
                    
                    {# Champ Distance Maximale #}
                    <div class="col-md-6">
                        {{ form_label(form.max_distance_user, 'Distance maximale (km)', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.max_distance_user, {'attr': {
                            'class': 'form-control',
                            'min': 0
                        }}) }}
                        {{ form_errors(form.max_distance_user) }}
                    </div>
                    
                    {# Champ Photo #}
                    <div class="col-md-6">
                        {{ form_label(form.photo_user, 'Photo de profil', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.photo_user, {'attr': {'class': 'form-control'}}) }}
                        {% if user.getPhotoUser %}
                            <div class="mt-2">
                        
                                     class="img-thumbnail" 
                                     style="max-width: 200px;">
                                <small class="form-text text-muted">Photo actuelle</small>
                            </div>
                        {% endif %}
                        {{ form_errors(form.photo_user) }}
                    </div>
                    
                    {# Champ Pièce Jointe #}
                    <div class="col-md-6">
                        {{ form_label(form.piece_jointe, 'Pièce jointe', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.piece_jointe, {'attr': {'class': 'form-control'}}) }}
                        {% if user.getPieceJointe %}
                            <div class="mt-2">
                                   target="_blank"
                                   class="btn btn-sm btn-info">
                                    Voir le fichier actuel
                                </a>
                            </div>
                        {% endif %}
                        {{ form_errors(form.piece_jointe) }}
                    </div>
                    
                    {# Champ Description #}
                    <div class="col-12">
                        {{ form_label(form.description_user, 'Description', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.description_user, {'attr': {
                            'class': 'form-control',
                            'rows': 3
                        }}) }}
                        {{ form_errors(form.description_user) }}
                    </div>
                    
                    {# Boutons #}
                    <div class="col-12 mt-4">
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-save me-2"></i>Enregistrer les modifications
                        </button>
                        <a href="{{ path('app_dashboard_user') }}" class="btn btn-secondary">
                            <i class="fas fa-times me-2"></i>Annuler
                        </a>
                    </div>
                    
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Activer les tooltips Bootstrap
    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
});
</script>
{% endblock %}